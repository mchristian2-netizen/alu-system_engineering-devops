#!/usr/bin/env bash
# Configures Nginx to add a custom X-Served-By header with the hostname

# Install Nginx
sudo apt-get update
sudo apt-get install -y nginx

# Add the custom header to the Nginx configuration
# We use sed to insert the add_header directive inside the http block
sudo sed -i "/include \/etc\/nginx\/sites-enabled\/\*;/i \\\tadd_header X-Served-By \$HOSTNAME;" /etc/nginx/nginx.conf

# Restart Nginx to apply the changes
sudo service nginx restart
