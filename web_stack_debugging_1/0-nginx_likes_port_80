#!/usr/bin/env bash
# Fixes Nginx to listen on port 80 of all active IPv4 IPs

# Replace any localhost or custom port bindings with standard port 80
sed -i 's/listen 127.0.0.1:80 default_server;/listen 80 default_server;/g' /etc/nginx/sites-available/default
sed -i 's/listen 8080 default_server;/listen 80 default_server;/g' /etc/nginx/sites-available/default

# Restart Nginx to apply the changes
service nginx restart
