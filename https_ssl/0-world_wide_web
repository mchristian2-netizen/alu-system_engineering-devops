#!/usr/bin/env bash
# Displays information about subdomains for a given domain

# Function to get and print subdomain info
get_subdomain_info() {
    local domain=$1
    local subdomain=$2
    local record_type=$(dig +short "$subdomain.$domain" | awk '{print $1}' | head -n 1)
    local destination=$(dig +short "$subdomain.$domain" A | head -n 1)
    
    # If no A record, try to get other record types
    if [ -z "$destination" ]; then
        record_type=$(dig +short "$subdomain.$domain" | awk '{print $2}' | head -n 1)
        destination=$(dig +short "$subdomain.$domain" | awk '{print $1}' | head -n 1)
    else
        record_type="A"
    fi

    echo "The subdomain $subdomain is a $record_type record and points to $destination"
}

# Main logic
if [ "$#" -eq 1 ]; then
    domain=$1
    for sub in www lb-01 web-01 web-02; do
        get_subdomain_info "$domain" "$sub"
    done
elif [ "$#" -eq 2 ]; then
    domain=$1
    subdomain=$2
    get_subdomain_info "$domain" "$subdomain"
fi
